<!--
  bare_world_acro.xml - bare_world.xml flown through the AcroMode plugin.

  Same airframe as bare_world.xml (mass 0.8, inertia 0.006 0.006 0.011,
  arms 0.18, k_tau 12), so the generated NMPC still matches it. Only the
  actuation differs:
      bare_world.xml       4 motors m0..m3, set by sim_node (ctrl = k_tau*u^2)
      bare_world_acro.xml  1 thrust + 3 torques, set by AcroMode's rate loop
                           from TRPYCommand on /quadrotor/trpy_cmd

  Ranges come from the 4-motor mixer, each motor 0..12 N at (+/-0.18, +/-0.18):
      fz  = f0+f1+f2+f3                     ->  0 .. 48     N
      tx  = 0.18 (f0+f1-f2-f3)              ->  +/- 4.32    N m
      ty  = -0.18 (f0-f1-f2+f3)             ->  +/- 4.32    N m
      tz  = 0.016 (f0-f1+f2-f3)             ->  +/- 0.384   N m
  These are per-axis bounds. Real motors couple them (full torque needs some
  motors at 0 N), which these separate actuators do not model.

  Load it with the plugin library already registered:
      mujoco.mj_loadPluginLibrary(".../libMujocoRosUtilsPlugin.so")
-->

<mujoco model="bare_world_acro">
    <!-- Declare the plugin before any actuator uses it, or MuJoCo reports
         "unrecognized plugin 'MujocoRosUtils::AcroMode'". -->
    <extension>
        <plugin plugin="MujocoRosUtils::AcroMode" />
    </extension>

    <option gravity="0 0 -9.81" timestep="0.002" />
    <compiler angle="radian" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" />
        <rgba haze="0.15 0.25 0.35 1" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.88 0.88 0.88"
                 rgb2="0.88 0.88 0.88" width="512" height="512" />
        <texture name="grid" type="2d" builtin="checker" width="512" height="512"
                 rgb1="0 0 0" rgb2="1 1 1" />
        <material name="grid" texture="grid" texrepeat="8 8" reflectance="0.1" />
        <material name="frame" rgba="0.25 0.25 0.28 1" />
        <material name="prop"  rgba="0.85 0.35 0.1 0.9" />
    </asset>

    <worldbody>
        <light pos="0 0 6" dir="0 0 -1" directional="true" />
        <geom name="floor" type="plane" size="20 20 0.05" material="grid" />

        <!-- AcroMode's body_name must match this EXACTLY. -->
        <body name="quadrotor" pos="0 0 0.5">
            <freejoint name="drone_root" />
            <inertial pos="0 0 0" mass="0.8" diaginertia="0.006 0.006 0.011" />

            <geom type="box" size="0.05 0.05 0.015" material="frame" mass="0" />
            <geom type="capsule" fromto="0.18 0.18 0 -0.18 -0.18 0"
                  size="0.007" material="frame" mass="0" />
            <geom type="capsule" fromto="0.18 -0.18 0 -0.18 0.18 0"
                  size="0.007" material="frame" mass="0" />
            <geom name="prop0" type="cylinder" pos=" 0.18  0.18 0.018"
                  size="0.07 0.002" material="prop" mass="0" />
            <geom name="prop1" type="cylinder" pos="-0.18  0.18 0.018"
                  size="0.07 0.002" material="prop" mass="0" />
            <geom name="prop2" type="cylinder" pos="-0.18 -0.18 0.018"
                  size="0.07 0.002" material="prop" mass="0" />
            <geom name="prop3" type="cylinder" pos=" 0.18 -0.18 0.018"
                  size="0.07 0.002" material="prop" mass="0" />

            <!-- At the centre of mass, axes = body axes: thrust along body z
                 with no parasitic torque, torques about the body axes. -->
            <site name="cog" pos="0 0 0" size="0.01" rgba="1 0 0 0" />
        </body>
    </worldbody>

    <actuator>
        <motor name="fz" site="cog" gear="0 0 1 0 0 0" ctrllimited="true" ctrlrange="0 48" />
        <motor name="tx" site="cog" gear="0 0 0 1 0 0" ctrllimited="true" ctrlrange="-4.32 4.32" />
        <motor name="ty" site="cog" gear="0 0 0 0 1 0" ctrllimited="true" ctrlrange="-4.32 4.32" />
        <motor name="tz" site="cog" gear="0 0 0 0 0 1" ctrllimited="true" ctrlrange="-0.384 0.384" />

        <!-- The host actuator. joint= must name a real joint: AcroMode calls
             mj_id2name(mjOBJ_JOINT, ...) on it (AcroMode.cpp, Create()). -->
        <plugin name="acro" plugin="MujocoRosUtils::AcroMode" joint="drone_root">
            <config key="topic_name"  value="/quadrotor/trpy_cmd" />
            <config key="actuator_fz" value="fz" />
            <config key="actuator_tx" value="tx" />
            <config key="actuator_ty" value="ty" />
            <config key="actuator_tz" value="tz" />
            <config key="control_hz"  value="500" />
            <config key="body_name"   value="quadrotor" />
        </plugin>
    </actuator>
</mujoco>
