<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quad_nmpc_ros_cpp</name>
  <version>0.1.0</version>
  <description>
    Trajectory-tracking NMPC for a quadrotor, in C++. The controller and its ROS
    wrapper -- everything that would run on the aircraft. The simulator stays in
    Python; it is a test fixture, not flight software.

    Also holds the Python NMPC (scripts/quad_nmpc_ros), which generates the
    acados solver and speaks the same two topics, so either controller drives
    the simulator.
  </description>
  <maintainer email="j.ajayadit@gmail.com">AjayAdit</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>actuator_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>quadrotor_msgs</depend>
  <depend>std_srvs</depend>

  <!-- the Python simulator and the Python NMPC, under scripts/ -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <!-- sim_node loads libMujocoRosUtilsPlugin.so (AcroMode) from it -->
  <exec_depend>mujoco_ros_utils</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
